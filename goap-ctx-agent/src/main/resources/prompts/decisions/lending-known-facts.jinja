{% extends "decision.jinja" %}
{% block question %}Which results of the application's checks are already established: the borrower's monthly income from pay stubs, whether employment was confirmed with the employer and the borrower's employment type (for example salaried or self-employed), how many months of reserves the bank statements show, the credit score and monthly obligations from the credit report, and the new loan's monthly instalment? Give amounts as plain numbers in USD.{% endblock %}
{% block shape %}{"monthlyIncome": number or null, "employmentConfirmed": true or null, "employmentType": "salaried, self-employed or null", "reservesMonths": number or null, "creditScore": number or null, "monthlyDebts": number or null, "instalment": number or null}{% endblock %}
